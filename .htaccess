# Block direct web access to sensitive files.
# These must never be downloadable over HTTP.
<FilesMatch "(?i)(firebase-service-account\.json|.*\.log|.*\.py|composer\.(json|lock)|\.gitignore)$">
    # Apache 2.4
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    # Apache 2.2 fallback
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
